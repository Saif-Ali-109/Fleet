# Multi Orchestration environment variables
# Copy to .env (or export these) — both are optional.

# Override the opencode binary path if it is not on PATH.
# The Manager shells out to this binary to spawn workers (default: "opencode").
# CLAUDE_BIN and CODEX_BIN similarly override the claude/codex CLIs.
OPENCODE_BIN=opencode

# Default agent backend the daemon triggers for each issue the 5-min scan finds.
# Valid values: opencode | claude | codex
ORCHESTRATOR_BACKEND=opencode

# Daemon rescan interval (minutes) for open issues.
SCAN_INTERVAL_MINUTES=5

# Optional: only set if you use the OpenRouter provider in opencode.
# The default free OpenCode Zen models (opencode/*) do NOT need this key.
OPENROUTER_API_KEY=

# Note: GitHub auth is via the `gh` CLI login (`gh auth login`), not env vars.

# Database configuration for Multi-Orchestration system of record
DATABASE_URL=postgresql://multiorm:multiorm@localhost:5432/multiorch?sslmode=disable
DATABASE_POOL_SIZE=10

# MCP server configuration
MCP_SERVER_PORT=8080

# Workforce policy path (optional, defaults to src/workforce/default-policy.json)
WORKFORCE_POLICY_PATH=

# Signed System of Record (SOR) — tamper-evident audit log
# Shared secret for HMAC-SHA256 hash chaining. Generate with: openssl rand -hex 32
SOR_SIGNING_KEY=

# Optional: override the hook event directory (default: <runDir>/events)
SOR_EVENT_DIR=
