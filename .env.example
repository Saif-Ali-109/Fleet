# Fleet environment variables
# Copy to .env (or export these) — both are optional.

# Override provider worker binaries if they are not on PATH or need a custom
# entry point (defaults: "node" — the worker script placeholder).
GEMINI_BIN=node
OPENROUTER_BIN=node
GROQ_BIN=node
OLLAMA_BIN=node

# Default provider the orchestrator uses for each issue.
# Valid values: gemini | openrouter | groq | ollama
ORCHESTRATOR_PROVIDER=groq

# Worker kill switch: hard timeout (ms) before a worker is killed, and grace
# period (ms) before SIGKILL after the initial termination (default: 1000).
WORKER_TIMEOUT_MS=
WORKER_TIMEOUT_GRACE_MS=

# Max characters of the diff shown to the reviewer (default: 25000).
MAX_REVIEW_DIFF_CHARS=

# Char budget for the git snapshot skeleton sent to workers (default: 8000).
SNAPSHOT_SKELETON_CHARS=

# Optional OpenRouter ranking headers forwarded to the openrouter provider.
HTTP_REFERER=
X_TITLE=

# Daemon rescan interval (minutes) for open issues.
SCAN_INTERVAL_MINUTES=5

# Optional: GitHub webhook secret for POST /webhook (queue mode hybrid trigger).
# Generate with: openssl rand -hex 32. Unset = webhook endpoint disabled (503).
WEBHOOK_SECRET=

# Providers in fallback priority order (comma-separated subset or reorder).
# Invalid names are skipped with a warning; default: gemini,openrouter,groq,ollama
FLEET_PROVIDERS=groq,gemini,openrouter,ollama

# Optional stable identifier for this manager instance, attached to telemetry
# events. Read by src/telemetry.ts.
FLEET_MANAGER_ID=

# Required for the primary provider path.
GEMINI_API_KEY=

# Optional: only set if you use the OpenRouter provider as a fallback.
# Unset = openrouter is skipped during the fleet fallback walk.
OPENROUTER_API_KEY=

# Optional: only set if you use the Groq provider (free tier friendly).
# Unset = groq is skipped during the fleet fallback walk.
# Console + keys: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: local Ollama endpoint. No API key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Output-token ceiling sent as `max_tokens` to every non-Gemini provider.
# Free tiers reject requests that reserve a model's full completion window
# (e.g. 65536), so this cap is required. `<ROLE>_MAX_OUTPUT_TOKENS` overrides
# `<PROVIDER>_MAX_OUTPUT_TOKENS` (e.g. GROQ_MAX_OUTPUT_TOKENS), which overrides
# this value. Default: 4096.
# On Groq's free tier prompt + max_tokens must stay under 8000 per request, so
# keep the provider default low and give editing roles (CODER/TESTER) a bigger
# override.
FLEET_MAX_OUTPUT_TOKENS=4096

# Retries after the first call for non-ollama providers (default 3). Free tiers
# with tight TPM windows (e.g. Groq's 8000 TPM) need more patience: raise this
# so a transient 429 waits the window out instead of failing the role.
FLEET_LLM_MAX_RETRIES=

# Stream chat completions (SSE) instead of blocking responses. Set to 1 for
# slow local backends (ollama on CPU): headers arrive immediately, so undici
# header timeouts can't fire while the model is still generating.
FLEET_LLM_STREAM=0

# Optional: enable detailed LLM request/response debug logging (1 = on).
# Shows tool_choice, tool_count, finish_reason, has_tool_calls for each call.
FLEET_LLM_DEBUG=

# Gemini quota coordinator. Per-model limits {rpm,tpm,rpd}.
# Edit any value here to override the code defaults (src/gemini/quotaConfig.ts).
# Unknown IDs (not listed below) MUST appear here or startup validation fails.
GEMINI_QUOTA_LIMITS={"gemini-3.7-flash":{"rpm":3,"tpm":250000,"rpd":18},"gemini-3.6-flash":{"rpm":3,"tpm":250000,"rpd":18},"gemini-3.5-flash":{"rpm":3,"tpm":250000,"rpd":18},"gemini-3.5-flash-lite":{"rpm":13,"tpm":240000,"rpd":495},"gemini-3.1-flash-lite":{"rpm":13,"tpm":240000,"rpd":495}}
# Ordered fallback pool used by every role when its primary model hits
# rpm/tpm/rpd limits. Every id listed MUST have a GEMINI_QUOTA_LIMITS entry,
# and all six <ROLE>_MODEL_GEMINI vars are REQUIRED at startup.
GEMINI_RATE_LIMIT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_RATE_LIMIT_WAIT_MS=120000
GEMINI_MAX_OUTPUT_TOKENS=8192
# Optional per-model runtime quota overrides applied on top of the coordinator
# defaults/limits above. Format mirrors GEMINI_QUOTA_LIMITS. Read by src/gemini/quotaConfig.ts.
GEMINI_QUOTA_OVERRIDES=
# Ollama resilience tuning:
#   OLLAMA_RETRY_DELAY_MS          - ms between retry attempts for ollama calls
#   OLLAMA_MAX_RETRIES             - max retry attempts for ollama transient
#                                    failures before rethrowing (default:
#                                    unlimited until WORKER_TIMEOUT_MS;
#                                    0 = fail on the first transient error)
#   OLLAMA_FIRST_TOKEN_TIMEOUT_MS  - streaming watchdog: abort + retry an
#                                    ollama call that never delivers a first
#                                    chunk within this window (CPU prompt-eval
#                                    on big prompts needs minutes)
#   OLLAMA_STALL_TIMEOUT_MS        - streaming watchdog: abort + retry when an
#                                    in-flight stream goes silent for this long
#                                    after its first chunk
OLLAMA_RETRY_DELAY_MS=5000
OLLAMA_MAX_RETRIES=
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=600000
OLLAMA_STALL_TIMEOUT_MS=30000

# Per-agent models (optional; tier defaults apply otherwise) — one per line.
# Pattern: <ROLE>_MODEL_<PROVIDER>
ANALYZER_MODEL_GEMINI=gemini-3.5-flash
PLANNER_MODEL_GEMINI=gemini-3.5-flash
REVIEWER_MODEL_GEMINI=gemini-3.5-flash
CODER_MODEL_GEMINI=gemini-3.5-flash-lite
TESTER_MODEL_GEMINI=gemini-3.5-flash-lite
PR_MODEL_GEMINI=gemini-3.5-flash-lite
# OpenRouter free models: nemotron-3-super (120B) is the most reliable free
# model for tool-calling + structured output across all six roles (proven in
# runs: analyzer FixSpec, reviewer reasoning, and it uses real function_calls,
# unlike minimax-m3 which emits tool markup as inline text).
ANALYZER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
PLANNER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
REVIEWER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
CODER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
TESTER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
PR_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
# Groq free-tier models (console.groq.com). gpt-oss-120b is the strongest
# tool-calling model on the free plan; gpt-oss-20b is faster/cheaper for the
# coder/tester/pr roles. Both accept OpenAI-style tools.
ANALYZER_MODEL_GROQ=openai/gpt-oss-120b
PLANNER_MODEL_GROQ=openai/gpt-oss-120b
REVIEWER_MODEL_GROQ=openai/gpt-oss-120b
CODER_MODEL_GROQ=openai/gpt-oss-20b
TESTER_MODEL_GROQ=openai/gpt-oss-20b
PR_MODEL_GROQ=openai/gpt-oss-20b
CODER_MODEL_OLLAMA=gemini-3.5-flash-lite
# Gemma 4 examples (via Gemini / Google AI Studio — free tier: 30 RPM / 16K TPM each)
# PLANNER_MODEL_GEMINI=gemma-4-31b-it
# ANALYZER_MODEL_GEMINI=gemma-4-31b-it
# CODER_MODEL_GEMINI=gemma-4-26b-a4b-it

# Note: GitHub auth is via the `gh` CLI login (`gh auth login`), not env vars.

# Database configuration for Fleet system of record
DATABASE_URL=postgresql://multiorm:multiorm@localhost:5432/fleet?sslmode=disable
DATABASE_POOL_SIZE=10

# Dedicated database for `npm test`. Optional: when unset, the test URL is
# derived from DATABASE_URL by swapping the database name to `fleet_test`.
# Tests refuse to run against any other database, because production
# concurrency accounting counts active worker rows globally and unrelated rows
# in a development database can change test outcomes. Create and migrate it
# with `npm run test:db:setup`.
# FLEET_TEST_DATABASE_URL=postgresql://multiorm:multiorm@localhost:5432/fleet_test?sslmode=disable

# MCP server configuration
MCP_SERVER_PORT=8080

# Workforce policy path (optional, defaults to src/workforce/default-policy.json)
WORKFORCE_POLICY_PATH=

# Signed System of Record (SOR) — tamper-evident audit log
# SOR key scheme — SOR_KEY_<KEY_ID> per key (uppercase, [^A-Z0-9] => "_").
# Example rotation: SOR_KEY_V1=<secret> SOR_KEY_V2=<other secret>; switch the
# current signing key with SOR_KEY_ID. Generate secrets with: openssl rand -hex 32
# v1 falls back to SOR_SIGNING_KEY when SOR_KEY_V1 is unset.
# SOR_KEY_ID selects the current signing key (default v1).
SOR_KEY_ID=v1
# Literal v1 key per the SOR_KEY_<KEY_ID> scheme above. When SOR_KEY_V1 is unset it
# falls back to SOR_SIGNING_KEY (legacy shared secret). Generate with: openssl rand -hex 32
SOR_KEY_V1=
# Legacy shared secret for HMAC-SHA256 hash chaining. Only used as the v1 key
# when SOR_KEY_V1 is unset (see SOR_KEY_* scheme above).
SOR_SIGNING_KEY=
# Optional: override the hook event directory (default: <runDir>/events)
SOR_EVENT_DIR=

# Content SoR (Phase 3) — manual content sync configuration
# CONTENT_EMBED_BATCH — max number of texts passed to the embed worker-child per
#   request before batching (default: 32). Used by src/runtime/embed/main.ts.
# CONTENT_EMBED_RANK — set to "true" to enable pgvector ANN re-ranking of FTS
#   retrieval results in the manager-side retrieval service (requires synced
#   embeddings). Default: FTS-only lexical lookup. Used by src/fleet/contentRetrieval.ts.
CONTENT_EMBED_BATCH=32
CONTENT_EMBED_RANK=false

# Context SoR (Phase 4) — freshness TTL configuration
# CONTEXT_TTL_HOURS — base TTL in hours for all context categories (default: 24).
# CONTEXT_TTL_RUN_HOURS / CONTEXT_TTL_ORG_HOURS — per-category overrides; when unset,
#   fall back to the base. Used by src/fleet/context.ts.
CONTEXT_TTL_HOURS=24
CONTEXT_TTL_RUN_HOURS=
CONTEXT_TTL_ORG_HOURS=
