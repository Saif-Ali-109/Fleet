{
  "name": "multi-orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript Manager that orchestrates a fleet of headless opencode workers to take a GitHub issue to a real PR, gated by 3 human approvals.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dry": "tsx --env-file-if-exists=.env src/index.ts --dry-run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:config": "tsx scripts/generate-configs.ts",
    "check:config": "tsx scripts/generate-configs.ts --check",
    "migrate:up": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "generate-memory": "tsx --env-file-if-exists=.env src/db/queries/summaryReport.ts",
    "analytics": "tsx --env-file-if-exists=.env src/analytics/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0"
  }
}
